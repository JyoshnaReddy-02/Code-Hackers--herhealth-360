# HerHealth 360 - Root Environment Variables Example
# Copy to backend/.env or frontend/.env as needed

# Flask Backend
FLASK_ENV=development
SECRET_KEY=dev-secret-herhealth-360-production-platform-key-2026
DATABASE_URL=sqlite:///instance/herhealth.db
# For production PostgreSQL: DATABASE_URL=postgresql://user:pass@host:5432/dbname
FRONTEND_ORIGIN=http://localhost:5173
PORT=5000

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1

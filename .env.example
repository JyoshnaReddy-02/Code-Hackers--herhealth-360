# HerHealth 360 - Environment Variables Reference
# Copy to backend/.env and frontend/.env as needed

# --- Flask Backend Settings ---
FLASK_ENV=development
SECRET_KEY=change-to-a-secure-random-secret-key-in-production

# --- Database Options ---
# Option 1: Shared Cloud MySQL (Allows localhost and Vercel to share the exact same accounts and data)
# DATABASE_URL=mysql+pymysql://<user>:<password>@<cloud-host>:3306/<database>

# Option 2: Local MySQL (Windows Service)
# DATABASE_URL=mysql+pymysql://root:<your_mysql_password>@localhost:3306/herhealth360

# Option 3: Local SQLite Backup (Default fallback)
DATABASE_URL=sqlite:///instance/herhealth.db

FRONTEND_ORIGIN=http://localhost:5173
PORT=5000

# E: Drive Local Cache Configuration
PYTHONPYCACHEPREFIX=E:\herhealth-360\.cache\python
TEMP=E:\herhealth-360\.tmp
TMP=E:\herhealth-360\.tmp

# --- Frontend (Vite) Settings ---
# In production on Vercel (same-domain), leave unset to default automatically to /api/v1.
# In local development if running standalone, set to http://localhost:5000/api/v1
VITE_API_BASE_URL=

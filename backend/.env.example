# HerHealth 360 - Backend Environment Configuration Example
FLASK_ENV=development
SECRET_KEY=change-to-a-secure-random-secret-key-in-production

# --- Database Options ---
# Option 1: TiDB Cloud Serverless (Shared Data Mode between localhost & Vercel)
# Replace <YOUR_TIDB_PASSWORD> with your actual database password:
# DATABASE_URL=mysql+pymysql://37mfJpbauCoe7c6.root:<YOUR_TIDB_PASSWORD>@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/herhealth360
# TIDB_CA_PATH=E:\herhealth-360\backend\certs\isrgrootx1.pem

# Option 2: Local Windows MySQL Service
# DATABASE_URL=mysql+pymysql://root:<your_local_password>@localhost:3306/herhealth360

# Option 3: Local SQLite Backup (Default fallback if unset)
DATABASE_URL=sqlite:///instance/herhealth.db

# Allowed frontend origin for CORS (use * or comma-separated URLs like https://your-app.vercel.app)
FRONTEND_ORIGIN=http://localhost:5173

# Local server port
PORT=5000

# Project cache and temporary directories on E: drive
PYTHONPYCACHEPREFIX=E:\herhealth-360\.cache\python
TEMP=E:\herhealth-360\.tmp
TMP=E:\herhealth-360\.tmp
